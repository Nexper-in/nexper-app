# Copy this file to .env.local and fill in your real values.
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nightly summary and udhaar reminders (optional)
# Secret for /api/cron/notify. Vercel sends it automatically to the cron job.
# CRON_SECRET=
# RESEND_API_KEY= and EMAIL_FROM= (already used for report emails) send the nightly summary by email.
# WhatsApp Cloud API: only needed to SEND reminders/summaries automatically. Without it the app
# prepares one-tap WhatsApp links instead. Needs a Meta business account and approved templates.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE_REMINDER=
# WHATSAPP_TEMPLATE_SUMMARY=
# WHATSAPP_TEMPLATE_LANG=en

# Show "Continue with Google" on the sign-in page (needs the Google provider set up in Supabase first)
NEXT_PUBLIC_GOOGLE_SIGNIN=false
# Public Google OAuth client ID (not a secret). Enables Google's own button on /login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Platform console (optional)
# Where invited people land after accepting an invite email, e.g. https://app.nexper.in
# NEXT_PUBLIC_APP_URL=
