# Copy this file to .env.local and fill in your real values.
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Phase 2 (WhatsApp Cloud API) — not needed to start
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Show "Continue with Google" on the sign-in page (needs the Google provider set up in Supabase first)
NEXT_PUBLIC_GOOGLE_SIGNIN=false

# Platform console (optional)
# Where invited people land after accepting an invite email, e.g. https://app.nexper.in
# NEXT_PUBLIC_APP_URL=
